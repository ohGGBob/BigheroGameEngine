# ====================== 构建相关 ======================
# 构建产物目录
build/
# CMake 缓存文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# 编译中间文件
*.obj
*.pdb
*.ilk
# 可执行文件、动态库、静态库
*.exe
*.dll
*.lib

# ====================== 临时、日志、压缩文件 ======================
*.log
*.tmp
*.cache
*.bak
*.zip
*.rar
*.7z

# ====================== VS编辑器本地配置 ======================
.vs/
*.vcxproj.user
*.suo
*.sln.docstates

# ====================== 系统自动生成文件 ======================
Thumbs.db
.DS_Store

# ====================== 引擎专属补充规则 ======================
# 着色器编译二进制产物（只保留glsl源码）
shaders/*.spv
# 资源烘焙缓存目录
assets/cache/
# ====================== 补充规则 ======================
# VS CMake预设的构建输出
out/build/
# 插件本地状态
.mimosa/
# 本地智能体状态（记忆/配置，不进仓库）
.workbuddy/
# ImGui文档与示例不进仓库（仅保留核心与backends）
thirdparty/imgui/docs/
thirdparty/imgui/examples/
thirdparty/imgui/misc/
thirdparty/imgui/.github/
