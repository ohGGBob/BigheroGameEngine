<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BigHero.Runtime —— 引擎 API 投影（托管运行时库）。
    位置约定（DESIGN.md §3）：本程序集加载进【默认 ALC，永不热重载】；
    用户脚本程序集（如 samples/scripts/MyGame）经 ProjectReference 引用本库，
    由宿主装载进 collectible ALC 整体卸载重载。

    <EnableDynamicLoading>true</EnableDynamicLoading> 是 hostfxr 嵌入的实测必需项
    （spike 坑 #4）：类库默认不生成 runtimeconfig.json，hostfxr_initialize_for_runtime_config
    会报 0x80008093 "runtimeconfig.json does not exist"。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BigHero.Runtime</RootNamespace>
    <AssemblyName>BigHero.Runtime</AssemblyName>
    <!-- 纯 BCL 依赖，零 NuGet 包引用：宿主按显式路径加载，无需 deps 解析 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
